{
  "expo": {
    "name": "NovaMeall",
    "slug": "Messp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "novameall",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/Logo.jpeg",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andres1482.Messp"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd517bb9-6c99-4cb0-9c63-bbf59bee132b"
      }
    }
  }
}